# Git files
.git/
.gitignore
.gitattributes

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Build artifacts
*.exe
*.dll
*.so
*.dylib
optimusdb
*.test
*.out

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Documentation (not needed in container)
*.md
README*
LICENSE*
docs/
documentation/

# Test files
*_test.go
testdata/
test/
tests/

# Node/JavaScript (if you have any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if you have any)
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/

# Data directories (don't copy to Docker)
data/
*.db
*.sqlite
*.sqlite3

# Vendor (will be regenerated in Docker)
vendor/

# Scripts and tools
scripts/
tools/
repoScript/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Docker files (don't copy Dockerfiles into themselves)
Dockerfile*
docker-compose*.yml
.dockerignore

# Build outputs
bin/
build/
dist/
out/

# Large binary files
*.tar
*.tar.gz
*.zip
*.rar
*.7z

# Media files (if not needed)
*.mp4
*.avi
*.mov
*.mp3
*.wav

# Backup files
*.bak
*.backup
*~
