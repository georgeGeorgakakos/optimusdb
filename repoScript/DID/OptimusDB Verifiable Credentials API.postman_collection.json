{
	"info": {
		"_postman_id": "15a3dba8-ecf8-436f-92f6-596f9edabced",
		"name": "OptimusDB Verifiable Credentials API",
		"description": "Complete collection of API endpoints for W3C Verifiable Credentials with IPFS/OrbitDB storage.\n\n**Base URL**: `http://localhost:18001/swarmkb/credentials`\n\n**Features**:\n\n- Store credentials in IPFS + OrbitDB + SQLite\n    \n- Query and filter credentials\n    \n- Verify credential authenticity\n    \n- Revoke credentials\n    \n- Audit trail with EventLog\n    \n\n**Version**: 1.0.0",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "40792570"
	},
	"item": [
		{
			"name": "1. Store Credentials",
			"item": [
				{
					"name": "Store Basic Credential",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test response",
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has success field\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"});",
									"",
									"pm.test(\"Response contains credentialId\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.credentialId).to.exist;",
									"    // Save for later use",
									"    pm.environment.set(\"lastCredentialId\", jsonData.credentialId);",
									"});",
									"",
									"pm.test(\"Response contains IPFS hash\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.ipfsHash).to.exist;",
									"});",
									"",
									"console.log(\"✅ Credential stored:\", pm.response.json().credentialId);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"@context\": [\"https://www.w3.org/2018/credentials/v1\"],\n  \"type\": [\"VerifiableCredential\"],\n  \"issuer\": \"did:example:issuer123\",\n  \"issuanceDate\": \"{{$isoTimestamp}}\",\n  \"credentialSubject\": {\n    \"id\": \"did:example:subject456\",\n    \"name\": \"Alice Smith\",\n    \"email\": \"alice@example.com\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/credentials",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"credentials"
							]
						},
						"description": "Store a basic verifiable credential with minimal required fields.\n\n**Required fields**:\n- `@context`: Must include W3C VC context\n- `type`: Must include \"VerifiableCredential\"\n- `issuer`: DID or URL of the issuer\n- `issuanceDate`: RFC3339 timestamp\n- `credentialSubject`: Object with subject data"
					},
					"response": []
				},
				{
					"name": "Store University Degree Credential",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"degreeCredentialId\", jsonData.credentialId);",
									"console.log(\"✅ Degree credential stored:\", jsonData.credentialId);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"@context\": [\n    \"https://www.w3.org/2018/credentials/v1\",\n    \"https://www.w3.org/2018/credentials/examples/v1\"\n  ],\n  \"id\": \"https://university.edu/credentials/2024/12345\",\n  \"type\": [\"VerifiableCredential\", \"UniversityDegreeCredential\"],\n  \"issuer\": {\n    \"id\": \"https://university.edu\",\n    \"name\": \"Example University\"\n  },\n  \"issuanceDate\": \"2024-05-15T10:00:00Z\",\n  \"expirationDate\": \"2034-05-15T10:00:00Z\",\n  \"credentialSubject\": {\n    \"id\": \"did:example:student789\",\n    \"name\": \"Bob Johnson\",\n    \"degree\": {\n      \"type\": \"BachelorDegree\",\n      \"name\": \"Bachelor of Science in Computer Science\",\n      \"degreeSchool\": \"School of Engineering\"\n    },\n    \"graduationDate\": \"2024-05-15\",\n    \"gpa\": 3.8\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/credentials",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"credentials"
							]
						},
						"description": "Store a university degree credential with extended context and custom fields.\n\n**Features**:\n- Custom credential ID\n- Issuer as object with name\n- Expiration date (10 years)\n- Structured degree information\n- Multiple credential types"
					},
					"response": []
				},
