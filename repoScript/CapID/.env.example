# Copy to .env and adjust. The client reads OPTIMUSDB_URL; the rest are used
# by the Makefile targets and the integration tests.
#
#   cp .env.example .env && set -a && . ./.env && set +a

# Agent the Capacity Provider writes to.
# Use a per-node path (/optimusdb1) — /api/v1/capacity has no load-balanced
# Traefik route, so the bare host will 404.
OPTIMUSDB_URL=http://193.225.250.240/optimusdb1

# Second agent, standing in for the one the Resource Agent reads from.
OPTIMUSDB_RA_URL=http://193.225.250.240/optimusdb2

# Set to run the integration tests against a live agent:
#   pytest -m integration
# OPTIMUS_TEST_URL=http://193.225.250.240/optimusdb1

# Identifiers used by the Makefile demo targets.
PROVIDER_ID=did:swarm:cp-iccs-01
CAPACITY_TYPE=compute
REGION=eu-gr-athens
EXPECTED_RA=did:swarm:ra-04
