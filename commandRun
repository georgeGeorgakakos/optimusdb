sudo kubectl run -it stomp-test --rm --restart=Never \
  --image=ghcr.io/nicolaka/netshoot:latest -- \
  bash -lc '
h="emsserver-ems-server.default.svc.cluster.local"
p=61610
u="${MQ_USER:-admin}"
pw="${MQ_PASS:-admin}"
t="${EMS_TOPIC:-/topic/>}"

exec 3<>/dev/tcp/$h/$p || { echo "cannot connect to $h:$p"; exit 1; }
printf "CONNECT\naccept-version:1.2\nhost:/\nlogin:%s\npasscode:%s\n\n\0" "$u" "$pw" >&3
sleep 0.2
body="{\"action\":\"probe\",\"resource\":\"health\",\"params\":{\"ping\":true}}"
printf "SEND\ndestination:%s\ncontent-type:application/json\ncontent-length:%d\n\n%s\0" "$t" "${#body}" "$body" >&3
echo "sent"
'
